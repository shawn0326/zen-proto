{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shawn0326/zen-proto/blob/master/crates/zen-frame-graph/schema/frame-graph-capture-v1.schema.json",
  "title": "FrameGraph Capture v1",
  "type": "object",
  "required": ["schema", "schema_version", "summary", "graph"],
  "properties": {
    "schema": { "const": "frame-graph-capture-v1" },
    "schema_version": { "const": 1 },
    "summary": {
      "type": "object",
      "required": [
        "recorded_node_count",
        "retained_node_count",
        "culled_node_count",
        "resource_count",
        "view_count",
        "access_count",
        "value_count",
        "dependency_count",
        "allocation_count",
        "timings"
      ]
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "culled_nodes",
        "resources",
        "views",
        "accesses",
        "values",
        "dependencies",
        "roots",
        "allocations",
        "execution_segments",
        "diagnostics"
      ]
    }
  },
  "additionalProperties": false
}
